# Supabase project base URL (the REST /rest/v1/ suffix is also accepted).
SUPABASE_URL=https://your-project.supabase.co
# Retained for future public features; private Orderly requests do not use this key.
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only secret/service-role key; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace_with_supabase_server_secret_key
# Exact browser origin; use your HTTPS origin in production.
ORDERLY_ORIGIN=http://localhost:3000
# Server-only provider encryption key: generate with openssl rand -hex 32.
# Keep this key stable; changing it requires reconnecting all providers.
ORDERLY_INTEGRATION_KEY=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
NOTION_CLIENT_ID=3f5d872b-594c-8119-a8a1-003771de3797
NOTION_CLIENT_SECRET=
# Notion developer portal webhook verification token (never NEXT_PUBLIC_).
NOTION_WEBHOOK_VERIFICATION_TOKEN=
